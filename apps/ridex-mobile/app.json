{
  "expo": {
    "name": "RideX Unified TEST Client",
    "slug": "ridex-unified-test",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.ridex.unified.test",
      "permissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.ridex.unified.test",
      "infoPlist": {
        "NSCameraUsageDescription": "RideX uses the camera for QR verification and profile/gallery features."
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "RideX needs access to your photos.",
          "cameraPermission": "RideX uses the camera for profile and QR features.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RideX uses location for pickup, matching and live active rides.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-camera",
      [
        "expo-notifications",
        {
          "color": "#0AA35A"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ]
  }
}
