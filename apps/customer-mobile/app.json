{
    "expo":  {
                 "name":  "RideX Customer TEST",
                 "slug":  "ridex-customer-test",
                 "scheme":  "ridex-customer-test",
                 "version":  "0.1.0",
                 "orientation":  "portrait",
                 "userInterfaceStyle":  "automatic",
                 "android":  {
                                 "package":  "com.ridex.customer.test",
                                 "permissions":  [
                                                     "android.permission.ACCESS_COARSE_LOCATION",
                                                     "android.permission.ACCESS_FINE_LOCATION",
                                                     "android.permission.CAMERA",
                                                     "android.permission.POST_NOTIFICATIONS"
                                                 ],
                                 "adaptiveIcon":  {
                                                      "foregroundImage":  "../logo/customer.png",
                                                      "backgroundColor":  "#FFFFFF"
                                                  },
                                 "icon":  "../logo/customer.png"
                             },
                 "ios":  {
                             "bundleIdentifier":  "com.ridex.customer.test",
                             "infoPlist":  {
                                               "NSCameraUsageDescription":  "RideX uses the camera only for supported role workflows."
                                           }
                         },
                 "plugins":  [
                                 [
                                     "expo-image-picker",
                                     {
                                         "photosPermission":  "RideX uses photos for profile and gallery features.",
                                         "cameraPermission":  "RideX uses the camera for profile and QR features.",
                                         "microphonePermission":  false
                                     }
                                 ],
                                 [
                                     "expo-location",
                                     {
                                         "locationWhenInUsePermission":  "RideX uses location for pickup selection and ride tracking.",
                                         "isAndroidBackgroundLocationEnabled":  false,
                                         "isAndroidForegroundServiceEnabled":  false,
                                         "isIosBackgroundLocationEnabled":  false
                                     }
                                 ],
                                 "expo-camera",
                                 [
                                     "expo-notifications",
                                     {
                                         "color":  "#0AA35A"
                                     }
                                 ],
                                 [
                                     "expo-secure-store",
                                     {
                                         "configureAndroidBackup":  true
                                     }
                                 ]
                             ],
                 "extra":  {
                               "eas":  {
                                           "projectId":  "d6cd57b9-0a96-4b93-acfc-39c6b8ff8752"
                                       }
                           },
                 "owner":  "ridex07",
                 "icon":  "../logo/customer.png"
             }
}
