  "actorScopeMatrix": [
    {
      "actor": "SUPER_ADMIN",
      "scope": "GLOBAL_UNRESTRICTED_FOR_AUTHORIZED_PRIVILEGED_ACTIONS",
      "requiredChecks": [
        "valid server session",
        "privileged action permission/purpose",
        "audit event",
        "additional confirmation/re-auth where required"
      ]
    },
    {
      "actor": "ADMIN_GLOBAL",
      "scope": "AUTHORIZED_GLOBAL_DATASET",
      "requiredChecks": [
        "active Admin account",
        "explicit permission",
        "server-side scope on all query/mutation/export paths"
      ]
    },
    {
      "actor": "ADMIN_STATE",
      "scope": "ASSIGNED_STATE_ONLY",
      "requiredChecks": [
        "active Admin account",
        "explicit permission",
        "stateId derived from assigned server-side scope",
        "nested resource state matches scope"
      ]
    },
    {
      "actor": "ADMIN_CITY",
      "scope": "ASSIGNED_CITY_ONLY",
      "requiredChecks": [
        "active Admin account",
        "explicit permission",
        "cityId derived from assigned server-side scope",
        "nested resource city/state matches scope"
      ]
    },
    {
      "actor": "CUSTOMER",
      "scope": "OWN_CUSTOMER_RESOURCES_ONLY",
      "requiredChecks": [
        "active session",
        "identity derived from session",
        "object ownership validation"
      ]
    },
    {
      "actor": "DRIVER",
      "scope": "OWN_DRIVER_RESOURCES_AND_ELIGIBLE_ASSIGNMENTS_ONLY",
      "requiredChecks": [
        "active session",
        "identity derived from session",
        "active eligible city/state assignment",
        "trip/offer ownership and state validation"
      ]
    },
    {
      "actor": "GATEWAY",
      "scope": "ENROLLED_GATEWAY_COMMANDS_ONLY",
      "requiredChecks": [
        "device/gateway identity authentication",
        "signature/session verification",
        "job/attempt binding",
        "no direct business trip state write"
      ]
    }
  ],
