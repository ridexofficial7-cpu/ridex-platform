      "rule": "Where an operation requires device identity, missing or mismatched device binding must not satisfy the binding.",
      "sourceEvidence": "services/backend/src/services/authSession.ts",
      "validation": "STATIC_SOURCE_PRESENT",
      "runtimeStatus": "NOT_RUN_DEFERRED_UNTIL_ALL_FOUR_PACKAGES_IMPLEMENTED"
    },
    {
      "id": "AUTH-INV-006",
      "rule": "Protected-action OTP verification issues a short-lived grant and does not mint a login session.",
      "sourceEvidence": "services/backend/src/routes/auth.ts; services/backend/src/services/protectedActionGrants.ts",
      "validation": "STATIC_SOURCE_PRESENT",
