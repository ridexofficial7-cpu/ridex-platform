      "validation": "STATIC_SOURCE_PRESENT",
      "runtimeStatus": "NOT_RUN_DEFERRED_UNTIL_ALL_FOUR_PACKAGES_IMPLEMENTED"
    },
    {
      "id": "AUTH-INV-002",
      "rule": "Persist only a SHA-256 hash of the raw session token; never persist or log the raw bearer token.",
