{
  "schemaVersion": 1,
  "policy": "en-IN / hi-IN only; en-IN fallback",
  "status": "PURE_LOGIC_CASES_EXECUTED_BY_STATIC_VALIDATOR; NO_DEVICE_OR_NETWORK_TEST",
  "cases": [
    {
      "id": "unauth_local_hi",
      "description": "Unauthenticated local preference wins over device locale",
      "input": {
        "authenticated": false,
        "localPreference": "hi-IN",
        "deviceLocales": [
          "en-IN"
        ]
      },
      "expected": {
        "locale": "hi-IN",
        "source": "LOCAL_PREFERENCE",
        "shouldPersistLocalPreference": false,
        "shouldSyncAccountPreference": false,
        "diagnostics": []
      }
    },
    {
      "id": "unauth_device_hi",
      "description": "Supported Hindi device locale chosen when local preference absent",
      "input": {
        "authenticated": false,
        "deviceLocales": [
          "hi-IN"
        ]
      },
      "expected": {
        "locale": "hi-IN",
        "source": "DEVICE_LOCALE",
        "shouldPersistLocalPreference": true,
        "shouldSyncAccountPreference": false,
        "diagnostics": []
      }
    },
    {
      "id": "unauth_device_hi_region",
      "description": "Hindi device region maps to configured supported Hindi locale",
      "input": {
        "authenticated": false,
        "deviceLocales": [
          "hi-NP"
        ]
      },
      "expected": {
        "locale": "hi-IN",
        "source": "DEVICE_LOCALE",
        "shouldPersistLocalPreference": true,
        "shouldSyncAccountPreference": false,
        "diagnostics": []
      }
    },
    {
      "id": "unauth_device_en_region",
      "description": "English device region maps to configured supported English locale",
      "input": {
        "authenticated": false,
        "deviceLocales": [
          "en-US"
        ]
      },
      "expected": {
        "locale": "en-IN",
        "source": "DEVICE_LOCALE",
        "shouldPersistLocalPreference": true,
        "shouldSyncAccountPreference": false,
        "diagnostics": []
      }
    },
    {
      "id": "unauth_fallback",
      "description": "Unsupported device language falls back to en-IN",
      "input": {
        "authenticated": false,
        "deviceLocales": [
          "bn-IN"
        ]
      },
      "expected": {
        "locale": "en-IN",
        "source": "DEFAULT_FALLBACK",
        "shouldPersistLocalPreference": true,
        "shouldSyncAccountPreference": false,
        "diagnostics": [
          "UNSUPPORTED_DEVICE_LOCALE"
        ]
      }
    },
    {
      "id": "unauth_unknown_local_then_device",
      "description": "Unsupported local preference is ignored and supported device locale used",
      "input": {
        "authenticated": false,
        "localPreference": "bn-IN",
        "deviceLocales": [
          "hi-IN"
        ]
      },
      "expected": {
        "locale": "hi-IN",
        "source": "DEVICE_LOCALE",
        "shouldPersistLocalPreference": true,
        "shouldSyncAccountPreference": false,
        "diagnostics": [
          "UNSUPPORTED_LOCAL_PREFERENCE"
        ]
      }
    },
    {
      "id": "unauth_explicit_wins",
      "description": "Explicit current-session selection wins before login",
      "input": {
        "authenticated": false,
        "currentSessionExplicitLocale": "hi-IN",
        "localPreference": "en-IN",
        "deviceLocales": [
          "en-IN"
        ]
      },
      "expected": {
        "locale": "hi-IN",
        "source": "CURRENT_SESSION_EXPLICIT_SELECTION",
        "shouldPersistLocalPreference": true,
        "shouldSyncAccountPreference": false,
        "diagnostics": []
      }
    },
    {
      "id": "unauth_invalid_explicit_local_kept",
      "description": "Invalid explicit selection does not override valid local choice",
      "input": {
        "authenticated": false,
        "currentSessionExplicitLocale": "bn-IN",
        "localPreference": "hi-IN",
        "deviceLocales": [
          "en-IN"
        ]
      },
      "expected": {
        "locale": "hi-IN",
        "source": "LOCAL_PREFERENCE",
        "shouldPersistLocalPreference": false,
        "shouldSyncAccountPreference": false,
        "diagnostics": [
          "UNSUPPORTED_CURRENT_SESSION_SELECTION"
        ]
      }
    },
    {
      "id": "auth_explicit_wins",
      "description": "Current session explicit choice wins over account preference",
      "input": {
        "authenticated": true,
        "currentSessionExplicitLocale": "en-IN",
        "accountPreference": "hi-IN",
        "localPreference": "hi-IN"
      },
      "expected": {
        "locale": "en-IN",
        "source": "CURRENT_SESSION_EXPLICIT_SELECTION",
        "shouldPersistLocalPreference": true,
        "shouldSyncAccountPreference": true,
        "diagnostics": []
      }
    },
    {
      "id": "auth_account_wins",
      "description": "Supported account preference wins when no current explicit choice",
      "input": {
        "authenticated": true,
        "accountPreference": "hi-IN",
        "localPreference": "en-IN",
        "deviceLocales": [
          "en-IN"
        ]
      },
      "expected": {
        "locale": "hi-IN",
        "source": "ACCOUNT_PREFERENCE",
        "shouldPersistLocalPreference": true,
        "shouldSyncAccountPreference": false,
        "diagnostics": []
      }
    },
    {
      "id": "auth_invalid_account_local",
      "description": "Unsupported account preference falls back to valid local preference and requests sync",
      "input": {
        "authenticated": true,
        "accountPreference": "bn-IN",
        "localPreference": "hi-IN",
        "deviceLocales": [
          "en-IN"
        ]
      },
      "expected": {
        "locale": "hi-IN",
        "source": "LOCAL_PREFERENCE",
        "shouldPersistLocalPreference": false,
        "shouldSyncAccountPreference": true,
        "diagnostics": [
          "UNSUPPORTED_ACCOUNT_PREFERENCE"
        ]
      }
    },
    {
      "id": "auth_missing_account_local",
      "description": "Missing account preference preserves local preference and requests sync",
      "input": {
        "authenticated": true,
        "localPreference": "en-IN"
      },
      "expected": {
        "locale": "en-IN",
        "source": "LOCAL_PREFERENCE",
        "shouldPersistLocalPreference": false,
        "shouldSyncAccountPreference": true,
        "diagnostics": []
      }
    },
    {
      "id": "auth_invalid_account_device",
      "description": "Unsupported account/local values use supported device locale and request sync",
      "input": {
        "authenticated": true,
        "accountPreference": "bn-IN",
        "localPreference": "ta-IN",
        "deviceLocales": [
          "hi-IN"
        ]
      },
      "expected": {
        "locale": "hi-IN",
        "source": "DEVICE_LOCALE",
        "shouldPersistLocalPreference": true,
        "shouldSyncAccountPreference": true,
        "diagnostics": [
          "UNSUPPORTED_ACCOUNT_PREFERENCE",
          "UNSUPPORTED_LOCAL_PREFERENCE"
        ]
      }
    },
    {
      "id": "auth_default_sync",
      "description": "No usable preference uses fallback and marks account sync",
      "input": {
        "authenticated": true
      },
      "expected": {
        "locale": "en-IN",
        "source": "DEFAULT_FALLBACK",
        "shouldPersistLocalPreference": true,
        "shouldSyncAccountPreference": true,
        "diagnostics": []
      }
    },
    {
      "id": "auth_account_case_normalize",
      "description": "Case/separator variations for enabled account locale normalize to canonical tag",
      "input": {
        "authenticated": true,
        "accountPreference": "HI_in"
      },
      "expected": {
        "locale": "hi-IN",
        "source": "ACCOUNT_PREFERENCE",
        "shouldPersistLocalPreference": true,
        "shouldSyncAccountPreference": false,
        "diagnostics": []
      }
    },
    {
      "id": "device_script_mismatch",
      "description": "Unsupported explicit script must not silently map",
      "input": {
        "authenticated": false,
        "deviceLocales": [
          "hi-Latn-IN"
        ]
      },
      "expected": {
        "locale": "en-IN",
        "source": "DEFAULT_FALLBACK",
        "shouldPersistLocalPreference": true,
        "shouldSyncAccountPreference": false,
        "diagnostics": [
          "UNSUPPORTED_DEVICE_LOCALE"
        ]
      }
    },
    {
      "id": "device_array_skip_unsupported",
      "description": "Device list skips unsupported language and selects next supported locale",
      "input": {
        "authenticated": false,
        "deviceLocales": [
          "bn-IN",
          {
            "languageTag": "hi-IN"
          }
        ]
      },
      "expected": {
        "locale": "hi-IN",
        "source": "DEVICE_LOCALE",
        "shouldPersistLocalPreference": true,
        "shouldSyncAccountPreference": false,
        "diagnostics": []
      }
    },
    {
      "id": "invalid_input_type",
      "description": "Malformed top-level input safely uses default fallback",
      "input": null,
      "expected": {
        "locale": "en-IN",
        "source": "DEFAULT_FALLBACK",
        "shouldPersistLocalPreference": true,
        "shouldSyncAccountPreference": false,
        "diagnostics": []
      }
    }
  ]
}
