{
  "schemaVersion": 1,
  "policyRevision": 1,
  "project": "RideX-Super_Admin_Controle",
  "purpose": "Fail-closed static checks for the fresh local development environment. This policy does not prove that the developer's Windows PostgreSQL service is running or that its database is newly created.",
  "foundation": {
    "environment": "TEST",
    "remoteDatabaseConnectionsAllowed": false,
    "productionDatabaseUrlMustBeEmpty": true,
    "genericDatabaseUrlFallbackAllowed": false,
    "businessDatabaseClientAccessAllowed": false,
    "activeSecretsInBundledEnvironmentFilesAllowed": false
  },
  "database": {
    "testVariable": "DATABASE_URL_TEST",
    "liveVariable": "DATABASE_URL_LIVE",
    "allowedTestHosts": [
      "localhost",
      "127.0.0.1",
      "::1"
    ],
    "requirePostgresProtocol": true,
    "testTargetEnforcement": "Every explicitly configured DATABASE_URL_TEST is required to be valid PostgreSQL and loopback-only, even when the process selects PRODUCTION; the selected target is validated as PostgreSQL."
  },
  "apiEndpoints": {
    "allowLoopbackHosts": [
      "localhost",
      "127.0.0.1",
      "::1"
    ],
    "allowAndroidEmulatorHost": "10.0.2.2",
    "allowPrivateLanOverrides": false,
    "allowPublicRemoteHosts": false,
    "blankEndpointAllowedForDisabledShells": true
  },
  "provider": {
    "requiredEnvironment": "TEST",
    "requiredLocalStorageDriver": "sqlite",
    "sqlitePathPrefix": "data/",
    "authoritativeRideXBusinessData": false,
    "postgresIntegrationStatus": "DECISION_PENDING"
  },
  "secretKeyPatterns": [
    "SECRET",
    "PASSWORD",
    "API_KEY",
    "ENCRYPTION_KEY",
    "PRIVATE_KEY",
    "ENROLLMENT_CODE"
  ],
  "environmentFiles": [
    "services/backend/.env.example",
    "services/broadcaster-provider/.env",
    "services/broadcaster-provider/.env.example",
    "apps/ridex-mobile/.env.example",
    "apps/customer-mobile/.env.example",
    "apps/driver-mobile/.env.example",
    "apps/admin-mobile/.env.example",
    "apps/admin-web/.env.example",
    "apps/admin-web/.env.test",
    "apps/super-admin-control/.env.example"
  ],
  "revision": 4,
  "date": "2026-10-15",
  "secretLeakPrevention": "Invalid RideX environment values are not echoed in thrown startup errors; startup logs record error class only.",
  "liveTargetEnforcement": "Production startup rejects DATABASE_URL_LIVE when malformed, non-PostgreSQL, or loopback-hosted."
}
